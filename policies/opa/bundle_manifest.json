{
  "bundle_name": "orca_policy_pre_bundle",
  "bundle_version": "0.1.0",
  "policy_package": "orca.policy.pre",
  "decision_path": "/v1/data/orca/policy/pre",
  "compatibility": {
    "external_adapter": "opa_http_v1",
    "input_contract": "policy_decision_v1",
    "output_contract": "status_reason_v1"
  },
  "tenant_scope": {
    "mode": "shared_with_tenant_constraints",
    "tenant_selection": "context_tenant_only",
    "cross_tenant_allowed": false
  },
  "promotion_policy": {
    "required_reviews": 1,
    "enforce_requires_shadow_validation": true,
    "require_bundle_version_bump": true,
    "environment_promotion": {
      "sequence": [
        "dev",
        "staging",
        "prod"
      ],
      "rules": {
        "dev_to_staging": {
          "require_shadow_parity": true,
          "min_runtime_canary_pass_ratio": 1.0
        },
        "staging_to_prod": {
          "require_shadow_parity": true,
          "min_runtime_canary_pass_ratio": 1.0,
          "required_approvals": 2
        }
      }
    }
  },
  "ownership": {
    "team": "runtime-policy",
    "review_required": true
  }
}
