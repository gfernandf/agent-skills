  "panels": [
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"expr": "agent_skills_uptime_seconds", "legendFormat": "uptime"}
      ]
    },
    {
      "title": "Binding Executions (total)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {"expr": "agent_skills_binding_execute_total", "legendFormat": "total"}
      ]
    },
    {
      "title": "Binding Success Rate",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "agent_skills_binding_execute_success_total / agent_skills_binding_execute_total",
          "legendFormat": "success_rate"
        }
      ]
    },
    {
      "title": "Binding Resolution Latency (ms)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "agent_skills_binding_resolution_ms_sum / agent_skills_binding_resolution_ms_count", "legendFormat": "avg_ms"}
      ]
    },
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "rate(agent_skills_binding_execute_total[5m])", "legendFormat": "req/s"}
      ]
    },
    {
      "title": "Fallback Usage",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 12},
      "targets": [
        {"expr": "agent_skills_binding_execute_fallback_used_total", "legendFormat": "fallbacks"}
      ]
    },
    {
      "title": "Circuit Breaker Opens",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 12},
      "targets": [
        {"expr": "agent_skills_binding_circuit_open_skip_total", "legendFormat": "circuit_open"}
      ]
    },
    {
      "title": "Idempotency Created (total)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 12},
      "targets": [
        {"expr": "agent_skills_runtime_idempotency_created_total", "legendFormat": "created"}
      ]
    },
    {
      "title": "Idempotency Reused (total)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 12},
      "targets": [
        {"expr": "agent_skills_runtime_idempotency_reused_total", "legendFormat": "reused"}
      ]
    },
    {
      "title": "Idempotency Conflict Rate (5m)",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "sum(rate(agent_skills_runtime_idempotency_conflict_total[5m])) / clamp_min(sum(rate(agent_skills_runtime_idempotency_created_total[5m])) + sum(rate(agent_skills_runtime_idempotency_reused_total[5m])) + sum(rate(agent_skills_runtime_idempotency_conflict_total[5m])), 1)",
          "legendFormat": "conflict_rate"
        }
      ]
    },
    {
      "title": "Idempotency Expiration Ratio (30m)",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 16},
      "targets": [
        {
          "expr": "sum(rate(agent_skills_runtime_idempotency_expired_total[30m])) / clamp_min(sum(rate(agent_skills_runtime_idempotency_created_total[30m])) + sum(rate(agent_skills_runtime_idempotency_reused_total[30m])), 1)",
          "legendFormat": "expiration_ratio"
        }
      ]
    },
    {
      "title": "Idempotency Event Rates (5m)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 16},
      "targets": [
        {
          "expr": "sum(rate(agent_skills_runtime_idempotency_created_total[5m]))",
          "legendFormat": "created/s"
        },
        {
          "expr": "sum(rate(agent_skills_runtime_idempotency_reused_total[5m]))",
          "legendFormat": "reused/s"
        },
        {
          "expr": "sum(rate(agent_skills_runtime_idempotency_conflict_total[5m]))",
          "legendFormat": "conflict/s"
        }
      ]
    }
  ],
